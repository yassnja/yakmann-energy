# Local development only: copy to site/.env if needed.
# On Netlify, set variables in the project's environment variables (Builds scope).

# Optional: Netlify already supplies its primary site URL automatically.
# SITE_URL=https://www.your-domain.example

# Optional: defaults to the Gmail recipient requested for testing.
# After the Zoho mailbox is ready, use contact@yakmannenergy.com and activate it
# through the confirmation email sent by FormSubmit.
# PUBLIC_CONTACT_RECIPIENT=contact@yakmannenergy.com
