---
import Base from '../layouts/Base.astro';
---

<Base title="Page introuvable — Yakmann Energy" description="Cette page n’existe pas ou a été déplacée.">
  <section class="container nf">
    <p class="label trace">Erreur 404</p>
    <h1 class="display">Ce circuit ne mène nulle part.</h1>
    <p class="lead">La page demandée n’existe pas ou a été déplacée.</p>
    <a class="btn" href="/" data-magnetic>Retour à l’accueil<span class="arrow" aria-hidden="true">→</span></a>
  </section>
</Base>

<style>
  .nf {
    min-height: 80vh;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: var(--space-m);
    padding-top: var(--header-h);
  }
  h1 {
    font-size: var(--step-5);
    max-width: 14ch;
  }
  .lead {
    color: var(--muted);
  }
</style>
