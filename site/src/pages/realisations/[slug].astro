---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { projects, categoryLabels, type Project } from '../../data/projects';
import { splitWords } from '../../lib/split';

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, prev: projects[(i - 1 + projects.length) % projects.length], next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  prev: Project;
  next: Project;
}

const { project, prev, next } = Astro.props;
const total = project.photos.length;
const gallery = await Promise.all(
  project.photos.map(async (photo, i) => ({
    photo,
    full: (await getImage({ src: photo, width: Math.min(1600, photo.width), format: 'webp' })).src,
    alt: `${project.name}, ${project.location} — photo ${i + 1} sur ${total}`,
  })),
);
const place = project.cities.length ? project.cities.join(', ') : null;
const description = `${project.name}${place ? ` (${place})` : ''} : ${
  project.scope ? project.scope.join(', ') + '. ' : ''
}Réalisation Yakmann Energy — travaux techniques pour établissements de santé au Maroc.`;
---

<Base title={`${project.name} — Réalisations Yakmann Energy`} description={description}>
  <article class="project">
    <header class="container head">
      <nav aria-label="Fil d’Ariane" class="crumbs label">
        <a href="/">Accueil</a><span aria-hidden="true">/</span><a href="/#realisations">Réalisations</a>
      </nav>
      <p class="label trace">{categoryLabels[project.category]}</p>
      <h1 class="display title split" data-reveal set:html={splitWords(project.name)} />

      <dl class="facts">
        {
          place && (
            <div>
              <dt class="label">{project.cities.length > 1 ? 'Villes' : 'Ville'}</dt>
              <dd>{place}</dd>
            </div>
          )
        }
        {
          project.scope && (
            <div class="wide">
              <dt class="label">Périmètre</dt>
              <dd>
                <ul role="list">
                  {project.scope.map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
              </dd>
            </div>
          )
        }
        {
          project.partners && (
            <div>
              <dt class="label">Références associées</dt>
              <dd>{project.partners.join(' · ')}</dd>
            </div>
          )
        }
        <div>
          <dt class="label">Photos</dt>
          <dd>{total}</dd>
        </div>
      </dl>
    </header>

    <div class="container">
      <div class="cover" data-mask>
        <Image
          src={project.coverImage}
          alt={`${project.name} — vue principale`}
          widths={[640, 1024, 1600]}
          sizes="(max-width: 90rem) 100vw, 90rem"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>

    <section class="container gallery-wrap" aria-labelledby="gallery-title">
      <h2 class="label trace" id="gallery-title">Chantier & livraison · {total} photos</h2>
      <ul role="list" class="gallery" data-gallery>
        {
          gallery.map((g, i) => (
            <li>
              <button type="button" class="shot" data-full={g.full} data-alt={g.alt} data-index={i} data-cursor="Agrandir">
                <Image src={g.photo} alt={g.alt} widths={[360, 600]} sizes="(max-width: 40rem) 50vw, (max-width: 64rem) 33vw, 25vw" />
                <span class="visually-hidden">Agrandir</span>
              </button>
            </li>
          ))
        }
      </ul>
      <p class="source">Photos issues du dossier de références Yakmann Energy 2026.</p>
    </section>

    <nav class="container pager" aria-label="Autres réalisations">
      <a href={`/realisations/${prev.slug}/`} class="pager-link">
        <span class="label">← Précédente</span>
        <span class="display">{prev.name}</span>
      </a>
      <a href={`/realisations/${next.slug}/`} class="pager-link next">
        <span class="label">Suivante →</span>
        <span class="display">{next.name}</span>
      </a>
    </nav>

    <aside class="cta on-ink">
      <div class="container cta-inner">
        <p class="display">Un projet comparable&nbsp;?</p>
        <a class="btn btn--light" href="/#contact" data-magnetic="0.25">Parler de votre projet<span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </aside>
  </article>

  <dialog class="lightbox" data-lightbox aria-label="Visionneuse de photos">
    <figure>

      <figcaption class="label" data-lb-caption></figcaption>
    </figure>
    <button type="button" class="lb-btn lb-close" data-lb-close aria-label="Fermer">✕</button>
    <button type="button" class="lb-btn lb-prev" data-lb-prev aria-label="Photo précédente">←</button>
    <button type="button" class="lb-btn lb-next" data-lb-next aria-label="Photo suivante">→</button>
  </dialog>
</Base>

<style>
  .head {
    padding-top: calc(var(--header-h) + var(--space-l));
    padding-bottom: var(--space-l);
    display: grid;
    gap: var(--space-m);
  }
  .crumbs {
    display: flex;
    gap: 0.6rem;
    color: var(--muted);
  }
  .crumbs a {
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--brand);
  }
  .title {
    font-size: var(--step-5);
    max-width: 18ch;
    color: var(--ink);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: var(--space-m);
    padding-top: var(--space-m);
    border-top: 1px solid var(--ink);
  }
  .facts .wide {
    grid-column: span 2;
  }
  .facts dt {
    color: var(--brand);
    margin-bottom: 0.35rem;
  }
  .facts li + li {
    margin-top: 0.2rem;
  }
  .cover {
    aspect-ratio: 16 / 8;
    overflow: hidden;
    background: var(--ink);
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery-wrap {
    padding-block: var(--space-xl);
    display: grid;
    gap: var(--space-m);
  }
  .gallery {
    columns: 4 16rem;
    column-gap: var(--space-s);
  }
  .gallery li {
    break-inside: avoid;
    margin-bottom: var(--space-s);
  }
  .shot {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: var(--paper-2);
    overflow: hidden;
    cursor: zoom-in;
  }
  .shot img {
    width: 100%;
    transition: transform 0.8s var(--ease-out);
  }
  .shot:hover img {
    transform: scale(1.04);
  }
  .source {
    color: var(--muted);
    font-size: 0.875rem;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--line);
  }
  .pager-link {
    display: grid;
    gap: 0.4rem;
    padding-block: var(--space-l);
    text-decoration: none;
  }
  .pager-link .display {
    font-size: var(--step-2);
  }
  .pager-link .label {
    color: var(--brand);
  }
  .pager-link:hover .display {
    color: var(--brand);
  }
  .next {
    text-align: right;
    padding-left: var(--space-m);
    border-left: 1px solid var(--line);
  }
  .cta {
    background: var(--ink);
    color: var(--white);
    padding-block: var(--space-xl);
  }
  .cta-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
  }
  .cta .display {
    font-size: var(--step-3);
  }

  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: clamp(3.5rem, 6vw, 5rem) clamp(0.5rem, 6vw, 6rem);
    border: 0;
    background: rgb(var(--ink-rgb) / 0.96);
    color: var(--white);
  }
  .lightbox::backdrop {
    background: rgb(var(--ink-rgb) / 0.9);
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
  }
  .lightbox figure {
    display: grid;
    gap: 0.75rem;
    justify-items: center;
    max-height: 100%;
  }
  .lightbox img {
    max-width: 100%;
    max-height: calc(100dvh - 9rem);
    object-fit: contain;
  }
  .lightbox figcaption {
    color: var(--muted-on-ink);
    text-align: center;
  }
  .lb-btn {
    position: fixed;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.3);
    background: rgb(var(--ink-rgb) / 0.7);
    color: var(--white);
    font-size: 1.1rem;
    transition:
      background-color 0.25s,
      color 0.25s;
  }
  .lb-btn:hover {
    background: var(--highlight);
    color: var(--ink);
  }
  .lb-close {
    top: 1rem;
    right: 1rem;
  }
  .lb-prev,
  .lb-next {
    top: 50%;
    translate: 0 -50%;
  }
  .lb-prev {
    left: 1rem;
  }
  .lb-next {
    right: 1rem;
  }

  @media (max-width: 44rem) {
    .facts .wide {
      grid-column: auto;
    }
    .cover {
      aspect-ratio: 4 / 3;
    }
    .gallery {
      columns: 2;
    }
    .pager {
      grid-template-columns: 1fr;
    }
    .next {
      text-align: left;
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .lb-prev,
    .lb-next {
      top: auto;
      bottom: 1rem;
      translate: none;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const shots = [...document.querySelectorAll<HTMLButtonElement>('[data-gallery] .shot')];
  if (dialog && shots.length) {
    const img = document.createElement('img');
    dialog.querySelector('figure')!.prepend(img);
    const caption = dialog.querySelector<HTMLElement>('[data-lb-caption]')!;
    let current = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      current = (i + shots.length) % shots.length;
      const shot = shots[current];
      img.src = shot.dataset.full!;
      img.alt = shot.dataset.alt!;
      caption.textContent = `${current + 1} / ${shots.length}`;
      // Précharge la suivante
      const nextShot = shots[(current + 1) % shots.length];
      new Image().src = nextShot.dataset.full!;
    };

    shots.forEach((shot, i) =>
      shot.addEventListener('click', () => {
        opener = shot;
        show(i);
        dialog.showModal();
      }),
    );
    dialog.querySelector('[data-lb-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-lb-next]')!.addEventListener('click', () => show(current + 1));
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      document.body.style.overflow = '';
      opener?.focus();
    });
    dialog.addEventListener('toggle', () => {
      if (dialog.open) document.body.style.overflow = 'hidden';
    });
  }
</script>
