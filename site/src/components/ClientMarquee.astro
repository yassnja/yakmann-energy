---
import ClientLogo from './ClientLogo.astro';
import { clients } from '../data/clients';
---

<section class="trust on-ink" aria-labelledby="trust-title">
  <div class="container trust-head">
    <h2 class="label trust-title" id="trust-title">
      <span class="trust-dot" aria-hidden="true"></span>Ils nous ont confié leurs projets
    </h2>
    <a class="label trust-link link-underline" href="#references">Toutes nos références · {clients.length}</a>
  </div>

  <div class="marquee" data-marquee>
    <div class="track">
      <ul role="list" class="row">
        {
          clients.map((c) => (
            <li style={`--h:${c.height}px`}>
              <ClientLogo src={c.mark} alt={c.name} height={c.height} />
            </li>
          ))
        }
      </ul>
      <!-- Copie pour une boucle continue, ignorée par les lecteurs d'écran -->
      <ul role="list" class="row" aria-hidden="true">
        {
          clients.map((c) => (
            <li style={`--h:${c.height}px`}>
              <ClientLogo src={c.mark} alt="" height={c.height} />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .trust {
    background: var(--ink);
    color: var(--white);
    padding-block: var(--space-l) var(--space-m);
    border-bottom: 1px solid var(--line-on-ink);
  }
  .trust-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem var(--space-m);
    margin-bottom: var(--space-m);
  }
  .trust-title {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    color: var(--muted-on-ink);
    font-weight: 500;
  }
  .trust-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px 2px rgb(var(--accent-rgb) / 0.6);
  }
  .trust-link {
    color: var(--accent);
    text-decoration: none;
  }

  .marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .track {
    display: flex;
    width: max-content;
  }
  .row {
    display: flex;
    align-items: center;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    padding-right: clamp(2.5rem, 5vw, 4.5rem);
    min-height: 6rem;
  }
  .row li {
    flex: none;
    display: grid;
    place-items: center;
    height: 4.5rem;
  }
  /* Logos en blanc monochrome : une ligne homogène, sans conflit de couleurs */
  .row :global(img) {
    display: block;
    height: var(--h);
    width: auto;
    max-width: 13rem;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.62;
    transition:
      opacity 0.4s var(--ease-expo),
      transform 0.5s var(--ease-expo);
  }
  .row li:hover :global(img) {
    opacity: 1;
    transform: scale(1.06);
  }

  @media (prefers-reduced-motion: no-preference) {
    .track {
      animation: marquee 70s linear infinite;
    }
    .marquee:hover .track,
    .marquee:focus-within .track {
      animation-play-state: paused;
    }
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  /* Sans animation : une grille fixe, sans la copie */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      -webkit-mask-image: none;
      mask-image: none;
    }
    .track {
      width: auto;
      padding-inline: var(--gutter);
    }
    .row {
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-m) var(--space-l);
      padding-right: 0;
    }
    .row[aria-hidden='true'] {
      display: none;
    }
  }
  @media (max-width: 40rem) {
    .row li {
      height: 3.5rem;
    }
    .row :global(img) {
      height: calc(var(--h) * 0.78);
    }
  }
</style>
