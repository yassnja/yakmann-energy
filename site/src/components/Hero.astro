---
import { Image } from 'astro:assets';
import { projectPhoto, projects, cities } from '../data/projects';
import { serviceCount } from '../data/company';
import { splitWords } from '../lib/split';

const heroPhoto = projectPhoto('hopital-mohammed-vi-mdiq', 3);
const sites = projects.filter((p) => p.cities.length > 0).length;

const stats = [
  { value: sites, suffix: '', label: 'établissements de santé référencés' },
  { value: cities.length, suffix: '', label: 'villes au Maroc' },
  { value: serviceCount, suffix: '', label: 'prestations techniques' },
  { value: 1600, suffix: ' A', label: 'tableaux électriques câblés jusqu’à' },
];
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <canvas class="hero-circuit" aria-hidden="true" data-circuit></canvas>

  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="label eyebrow hero-in" style="--d:0">
        <span class="pulse" aria-hidden="true"></span>Courant fort &amp; faible · Casablanca, Maroc
      </p>
      <h1 id="hero-title" class="display hero-title split" set:html={splitWords('Nous équipons les lieux où l’on soigne.', 0, 6)} />
      <p class="lead hero-lead hero-in" style="--d:1">
        Électricité CFO/CFA, climatisation et traitement d’air, plombage des salles de radiologie, revêtements de bloc
        opératoire et second œuvre&nbsp;: Yakmann Energy réalise les travaux techniques des centres d’imagerie, cliniques
        et hôpitaux, partout au Maroc.
      </p>
      <div class="hero-actions hero-in" style="--d:2">
        <a class="btn" href="#contact" data-magnetic>
          <span class="btn-label">Parler de votre projet</span><span class="arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost" href="#realisations" data-magnetic="0.25"><span class="btn-label">Voir les réalisations</span></a>
      </div>
    </div>

    <figure class="hero-visual" data-hero-visual>
      <div class="hero-media">
        <Image
          src={heroPhoto}
          alt="Salle IRM sous plafond lumineux à motif de palmier, Hôpital Mohammed VI de M’diq"
          widths={[480, 760, 1127]}
          sizes="(max-width: 62rem) 100vw, 45vw"
          loading="eager"
          fetchpriority="high"
          class="hero-img"
          data-hero-img
        />
      </div>
      <svg class="waves" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <path class="w-band w-navy" d="M-4 0 L66 0 C28 40 98 64 50 100 L-4 100 Z"></path>
        <path class="w-band w-cyan" d="M-4 0 L60 0 C20 38 86 66 34 100 L-4 100 Z"></path>
        <path class="w-band w-paper" d="M-4 0 L55 0 C12 35 74 66 18 100 L-4 100 Z"></path>
      </svg>
      <figcaption class="label hero-caption">
        <span class="rec" aria-hidden="true"></span>Salle IRM — Hôpital Mohammed VI, M’diq
      </figcaption>
    </figure>
  </div>

  <div class="container">
    <dl class="stats">
      {
        stats.map((s, i) => (
          <div class="stat hero-in" style={`--d:${3 + i * 0.5}`}>
            <dt class="label">{s.label}</dt>
            <dd class="display" data-count={s.value} data-suffix={s.suffix}>
              {s.value}
              {s.suffix}
            </dd>
          </div>
        ))
      }
    </dl>
    <a href="#entreprise" class="scroll-cue label hero-in" style="--d:4">
      <span class="cue-line" aria-hidden="true"></span>Découvrir
    </a>
  </div>

  <svg class="hero-divider" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" data-divider>
    <path class="d-cyan" d="M0 100 C 38 100 62 36 100 0 L100 100 Z"></path>
    <path class="d-navy" d="M0 100 C 42 100 68 46 100 14 L100 100 Z"></path>
    <path class="d-ink" d="M0 100 C 46 100 72 56 100 28 L100 100 Z"></path>
  </svg>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-top: calc(var(--header-h) + var(--space-l));
    padding-bottom: clamp(4rem, 8vw, 7.5rem);
    background: var(--paper);
    overflow: hidden;
  }
  .hero-circuit {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent 95%);
    mask-image: linear-gradient(to bottom, #000 55%, transparent 95%);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: var(--space-l);
    align-items: stretch;
    min-height: min(76vh, 50rem);
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-m);
    padding-block: var(--space-l);
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--brand);
  }
  .pulse {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
  }
  .pulse::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 1px solid var(--accent);
    animation: pulse 2.4s var(--ease-out) infinite;
  }
  @keyframes pulse {
    from {
      transform: scale(0.6);
      opacity: 1;
    }
    to {
      transform: scale(2.2);
      opacity: 0;
    }
  }
  .hero-title {
    font-size: var(--step-5);
    font-stretch: 118%;
    max-width: 12ch;
    color: var(--ink);
  }
  .hero-title :global(.w-accent > span) {
    background: linear-gradient(var(--accent-soft), var(--accent-soft)) 0 88% / 100% 0.14em no-repeat;
  }
  .hero-lead {
    max-width: 38rem;
    color: var(--muted);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: var(--space-2xs);
  }

  .hero-visual {
    position: relative;
    min-height: 26rem;
  }
  .hero-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--ink);
  }
  .hero-img {
    position: absolute;
    top: -6%;
    left: -3%;
    width: 106%;
    height: 112%;
    max-width: none;
    object-fit: cover;
    object-position: 60% 40%;
    translate: calc(var(--mx, 0) * -16px) calc(var(--my, 0) * -10px);
    transition: translate 0.9s var(--ease-expo);
  }
  .waves {
    position: absolute;
    top: -1px;
    left: -1px;
    width: 34%;
    height: calc(100% + 2px);
    pointer-events: none;
    overflow: visible;
  }
  .w-band {
    transition: translate 0.9s var(--ease-expo);
  }
  .w-navy {
    fill: var(--navy);
    translate: calc(var(--mx, 0) * 3px) 0;
  }
  .w-cyan {
    fill: var(--accent);
    translate: calc(var(--mx, 0) * 1.6px) 0;
  }
  .w-paper {
    fill: var(--paper);
  }
  .hero-caption {
    position: absolute;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.9rem;
    background: rgb(var(--ink-rgb) / 0.82);
    color: var(--white);
    font-size: 0.6875rem;
  }
  .rec {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    animation: blink 1.6s steps(2, jump-none) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0.2;
    }
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: var(--space-xl);
    border-top: 1px solid var(--line);
  }
  .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.5rem;
    padding: var(--space-m) var(--space-m) 0 0;
  }
  .stat + .stat {
    padding-left: var(--space-m);
    border-left: 1px solid var(--line);
  }
  .stat dt {
    color: var(--muted);
    max-width: 16rem;
  }
  .stat dd {
    font-size: var(--step-4);
    color: var(--ink);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .scroll-cue {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: var(--space-l);
    color: var(--muted);
    text-decoration: none;
  }
  .cue-line {
    position: relative;
    width: 1px;
    height: 2.5rem;
    background: var(--line);
    overflow: hidden;
  }
  .cue-line::after {
    content: '';
    position: absolute;
    left: 0;
    top: -40%;
    width: 1px;
    height: 40%;
    background: var(--brand);
    animation: cue 2s var(--ease-in-out) infinite;
  }
  @keyframes cue {
    to {
      top: 100%;
    }
  }
  .scroll-cue:hover {
    color: var(--brand);
  }

  /* Transition vers la section suivante : la vague de la couverture monte */
  .hero-divider {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    width: 100%;
    height: clamp(4rem, 10vw, 9rem);
    transform-origin: bottom;
    pointer-events: none;
  }
  .d-cyan {
    fill: var(--accent);
  }
  .d-navy {
    fill: var(--navy);
  }
  .d-ink {
    fill: var(--ink);
  }

  /* ---------------------------------------------------------- Entrée cinématique */
  @media (prefers-reduced-motion: no-preference) {
    .hero-title :global(.w > span) {
      animation: word-up 1.15s var(--ease-expo) both;
      animation-delay: calc(var(--i) * 75ms + 150ms);
    }
    .hero-title :global(.w-accent > span) {
      animation:
        word-up 1.15s var(--ease-expo) both,
        underline 0.9s var(--ease-expo) both;
      animation-delay:
        calc(var(--i) * 75ms + 150ms),
        1.1s;
    }
    .hero-in {
      animation: fade-up 1s var(--ease-expo) both;
      animation-delay: calc(var(--d) * 110ms + 650ms);
    }
    .eyebrow.hero-in {
      animation-delay: 80ms;
    }
    .hero-media {
      animation: open-seam 1.5s var(--ease-in-out) 0.25s both;
    }
    .waves {
      animation: fade 0.01s linear 0.95s backwards;
    }
    .hero-img {
      animation: settle 2.4s var(--ease-expo) 0.25s backwards;
    }
    .w-band {
      animation: band-in 1.4s var(--ease-expo) backwards;
    }
    .w-navy {
      animation-delay: 1.15s;
    }
    .w-cyan {
      animation-delay: 1.05s;
    }
    .w-paper {
      animation-delay: 0.95s;
    }
    .hero-caption {
      animation: fade-up 0.8s var(--ease-expo) 1.4s both;
    }
  }
  @keyframes word-up {
    from {
      transform: translateY(108%);
    }
    to {
      transform: none;
    }
  }
  @keyframes underline {
    from {
      background-size: 0% 0.14em;
    }
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  @keyframes open-seam {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes settle {
    from {
      transform: scale(1.22);
    }
  }
  @keyframes band-in {
    from {
      transform: translateX(-40%);
      opacity: 0;
    }
  }

  @media (max-width: 62rem) {
    .hero-grid {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .hero-copy {
      padding-block: var(--space-s) 0;
    }
    .hero-visual {
      min-height: 0;
      aspect-ratio: 4 / 3;
    }
    .waves {
      width: 30%;
    }
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .stat + .stat:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--line);
      margin-top: var(--space-m);
    }
    .scroll-cue {
      display: none;
    }
  }
  @media (max-width: 30rem) {
    .stat dd {
      font-size: var(--step-3);
    }
  }
  @media (max-width: 26rem) {
    .hero-visual {
      aspect-ratio: 1;
    }
    .hero-actions .btn {
      flex: 1 1 100%;
    }
  }
</style>

<script>
  import { initCircuit } from '../scripts/circuit';

  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  initCircuit(hero.querySelector<HTMLCanvasElement>('[data-circuit]')!, { reduced, interactive: fine });

  // Parallaxe au pointeur : la photo et les bandes réagissent à des profondeurs différentes
  if (fine && !reduced) {
    const visual = hero.querySelector<HTMLElement>('[data-hero-visual]')!;
    let raf = 0;
    hero.addEventListener('pointermove', (e) => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const r = hero.getBoundingClientRect();
        visual.style.setProperty('--mx', ((e.clientX - r.left) / r.width - 0.5).toFixed(3));
        visual.style.setProperty('--my', ((e.clientY - r.top) / r.height - 0.5).toFixed(3));
      });
    });
    hero.addEventListener('pointerleave', () => {
      visual.style.setProperty('--mx', '0');
      visual.style.setProperty('--my', '0');
    });
  }
</script>
